# ==============================================================
# LeetXracker - Cloud Deployment Environment Variables (.env)
# ==============================================================

# Super Admin Credentials
SUPER_ADMIN_PASSWORD=SurajSir

# LeetCode Credentials for surajdas@surajdas.com (Auto-Populated on Start)
LEETCODE_SESSION=
CSRF_TOKEN=

# Cloud AI API Keys (Used when local OmniRoute is unreachable)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local / Remote OmniRoute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-coding

# Preferred Model Selectors
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Automation Defaults
TARGET_COUNT=50
DELAY_SECONDS=1
DIFFICULTY=ALL
LANGUAGE=python3
MAX_RETRIES=2

# Optional 100% Free Cloud Database Persistence (Firebase Realtime DB)
FIREBASE_DATABASE_URL=
FIREBASE_AUTH_SECRET=
